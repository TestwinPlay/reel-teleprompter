{
  "name": "reel-teleprompter",
  "version": "1.0.0",
  "description": "Free, private browser teleprompter that records Instagram Reels from your laptop: split-screen screen recording, drawing tools, floating preview, AI noise removal. Agent skill for Codex and Claude Code.",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "author": "TestwinPlay / Aakash Singh",
  "homepage": "https://github.com/TestwinPlay/reel-teleprompter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TestwinPlay/reel-teleprompter.git"
  },
  "bugs": {
    "url": "https://github.com/TestwinPlay/reel-teleprompter/issues"
  },
  "keywords": [
    "teleprompter",
    "instagram-reels",
    "screen-recorder",
    "video-recorder",
    "agent-skill",
    "noise-suppression"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "vendor": "mkdir -p skills/reel-teleprompter/app/vendor/noise && D=node_modules/@sapphi-red/web-noise-suppressor/dist && cp $D/index.js skills/reel-teleprompter/app/vendor/noise/index.js && cp $D/rnnoise/workletProcessor.js skills/reel-teleprompter/app/vendor/noise/rnnoiseWorklet.js && cp $D/rnnoise.wasm $D/rnnoise_simd.wasm skills/reel-teleprompter/app/vendor/noise/"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "wrangler": "^4.129.0"
  }
}

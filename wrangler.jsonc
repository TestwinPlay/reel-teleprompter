{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local dev (`npm run dev`). Deploy only with --env staging|production.
  "name": "reel-teleprompter-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // account: set CLOUDFLARE_ACCOUNT_ID, or wrangler uses the logged-in account
  "assets": { "directory": "./skills/reel-teleprompter/app", "html_handling": "auto-trailing-slash" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "reel-teleprompter-staging",
      "workers_dev": true,
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] }
    },
    "production": {
      "name": "reel-teleprompter",
      "workers_dev": true,
      // add "routes": [{ "pattern": "<domain>", "custom_domain": true }] once a domain is chosen
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] }
    }
  }
}
